# ─── Environment Variables Example ───────────────────────────────────────────
# Salin file ini menjadi .env untuk development lokal:
#   cp .env.example .env
#
# Untuk production (Vercel), set variabel-variabel ini di:
#   Vercel Dashboard → Project → Settings → Environment Variables

# Environment: "development" atau "production"
NODE_ENV=development

# Port server (development only, Vercel mengatur port otomatis di production)
PORT=3000

# Secret key untuk signing cookie session.
# Development: boleh nilai bebas.
# Production: WAJIB string acak yang panjang dan aman.
# Generate dengan: openssl rand -hex 32
SESSION_SECRET=your-secret-key-here
