<%- include('../partials/head') %>
<% locals.path = '/products' %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <%- include('../partials/flash') %>

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= title %></h1>
      <p class="page-subtitle"><a href="/products">← Back to Products</a></p>
    </div>
  </div>

  <div class="card form-card">
    <form action="<%= action %>" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label for="name">Product Name *</label>
          <input type="text" id="name" name="name" value="<%= product.name || '' %>" placeholder="e.g. Laptop Dell XPS" required />
        </div>
        <div class="form-group">
          <label for="category">Category *</label>
          <select id="category" name="category" required>
            <option value="">Select category</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= product.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="price">Price (Rp) *</label>
          <input type="number" id="price" name="price" value="<%= product.price || '' %>" placeholder="e.g. 15000000" min="0" step="0.01" required />
        </div>
        <div class="form-group">
          <label for="stock">Current Stock</label>
          <input type="number" id="stock" name="stock" value="<%= product.stock !== undefined ? product.stock : 0 %>" min="0" />
        </div>
        <div class="form-group">
          <label for="minStock">Min. Stock Alert</label>
          <input type="number" id="minStock" name="minStock" value="<%= product.minStock !== undefined ? product.minStock : 5 %>" min="0" />
        </div>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3" placeholder="Optional product description"><%= product.description || '' %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= product._id ? 'Update Product' : 'Create Product' %></button>
        <a href="/products" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
