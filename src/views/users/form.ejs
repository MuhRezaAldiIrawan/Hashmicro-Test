<%- include('../partials/head') %>
<% locals.path = '/users' %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <%- include('../partials/flash') %>

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= title %></h1>
      <p class="page-subtitle"><a href="/users">← Back to Users</a></p>
    </div>
  </div>

  <div class="card form-card">
    <form action="<%= action %>" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label for="name">Full Name *</label>
          <input type="text" id="name" name="name" value="<%= user.name || '' %>" required />
        </div>
        <div class="form-group">
          <label for="username">Username *</label>
          <input type="text" id="username" name="username" value="<%= user.username || '' %>"
            <%= user._id ? 'readonly' : 'required' %> />
          <% if (user._id) { %><small class="hint">Username cannot be changed.</small><% } %>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= user.email || '' %>" />
        </div>
        <div class="form-group">
          <label for="role">Role</label>
          <select id="role" name="role">
            <% roles.forEach(r => { %>
              <option value="<%= r %>" <%= user.role === r ? 'selected' : '' %>><%= r %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label for="password">Password <%= user._id ? '<span class="optional">(leave blank to keep current)</span>' : '*' %></label>
        <input type="password" id="password" name="password" placeholder="<%= user._id ? 'Leave blank to keep' : 'Min. 6 characters' %>" <%= user._id ? '' : 'required' %> />
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= user._id ? 'Update User' : 'Create User' %></button>
        <a href="/users" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
